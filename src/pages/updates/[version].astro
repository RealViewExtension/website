---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { WEB_STORE_URL, releaseUrl, url, formatDate } from '../../lib/site';

export async function getStaticPaths() {
  const updates = await getCollection('updates');
  return updates.map((entry) => ({ params: { version: entry.data.version }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base title={`Version ${entry.data.version}`} description={`RealView ${entry.data.version}: ${entry.data.title}.`}>
  <section class="section">
    <div class="wrap prose">
      <p><a href={url('updates/')}>&larr; All updates</a></p>
      <div class="meta">
        <span class="version">{entry.data.version}</span>
        <time datetime={entry.data.date.toISOString().slice(0, 10)}>{formatDate(entry.data.date)}</time>
        <span class:list={['badge', entry.data.kind]}>{entry.data.kind}</span>
      </div>
      <h1>{entry.data.title}</h1>
      <Content />
      <p class="actions">
        <a class="btn primary" href={WEB_STORE_URL} rel="noopener">Get it on the Chrome Web Store</a>
        <a class="btn" href={releaseUrl(entry.data.version)} rel="noopener">Early access zip on GitHub</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .meta {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--fg-muted);
    font-size: 0.9rem;
    margin-bottom: 0.8rem;
  }
  .version {
    font-family: var(--mono);
    font-weight: 700;
    color: var(--fg);
  }
  h1 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
</style>
